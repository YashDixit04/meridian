# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/test?retryWrites=true&w=majority

# Atlas API Keys (for local dev IP auto-whitelisting script)
# Need "Project IP Access List Admin" permission. Do not commit your real keys!
ATLAS_PUBLIC_KEY=your_public_key
ATLAS_PRIVATE_KEY=your_private_key
ATLAS_PROJECT_ID=your_project_id

# Redis configuration (for BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
